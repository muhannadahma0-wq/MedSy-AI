# MedSync-AI — environment template (copy to .env and fill your own values)
# NEVER commit the real .env (it is git-ignored)

# Supabase PostgreSQL session-pooler URL (use port 5432, not transaction mode 6543).
# Copy from Supabase Dashboard -> Connect -> Session pooler. Never commit real credentials.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require"
# Prisma CLI schema-sync connection. Use the Supabase session-pooler URL here as well,
# or a verified direct URL if your Render environment can reach it.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require"

# Session signing secret — generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME_random_base64

# AI providers (optional — the chain degrades gracefully to z-ai GLM if absent)
GROQ_API_KEY=
GOOGLE_API_KEY=

# Optional per-model overrides (defaults live in src/lib/server/models/)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.8-flash
# MEDICAL_PRIMARY=groq | gemini | zai

# Socket.IO (hosted service)
# Browser-facing URL; Render Blueprint populates the public service URL.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3003
NEXT_PUBLIC_SOCKET_PATH=/socket.io/
# Server-to-server signed notification bridge; defaults to SOCKET_PUBLIC_URL + /emit.
SOCKET_PUBLIC_URL=http://localhost:3003
# Optional complete endpoint override:
# SOCKET_EMIT_URL=http://localhost:3003/emit
SOCKET_PATH=/socket.io/
SOCKET_CORS_ORIGINS=*
